# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and loaded for dev/build, but skipped when NODE_ENV=test — so
# the test suite never accidentally depends on real credentials being
# present. See docs/PLAN.md's Stage 5 prerequisites for full setup steps.

# --- Auth.js (next-auth v5) — Google OAuth, restricted to an allow-list ---
# Client ID/Secret come from a Google Cloud Console OAuth Client (Web
# application type, User Type: External). Created under
# engelus@creativejourneysph.com — the business keeps ownership of its own
# login infrastructure rather than depending on a developer's personal
# account. The consent screen's "Test users" list must also contain every
# address below, or Google blocks sign-in before the request ever reaches
# this app.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated, no spaces. Anyone signing in with a Google account NOT
# on this list is rejected in the app's signIn callback, even if Google's
# own Test users list would have let the OAuth flow complete.
AUTH_ALLOWED_EMAILS=hello@creativejourneysph.com,jet.arciaga@gmail.com,engelus@creativejourneysph.com

# --- Supabase Data API ---
# Project Settings -> API Keys, the "Publishable and secret API keys" tab
# (not the old Legacy tab, and not the separate "Data API" integrations
# page, which only shows the REST URL). NEXT_PUBLIC_SUPABASE_URL is the
# plain Project URL, no /rest/v1/ suffix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase Transaction Pooler, server-only ---
# From the Connect panel. Discrete host/user/password — do NOT collapse
# these into a single DATABASE_URL string; D-009 in docs/PLAN.md replaced
# the old Neon/local-Docker DATABASE_URL with this discrete-vars pattern,
# matching the portfolio project's lib/db.ts.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

# Server-only. Never prefix with NEXT_PUBLIC_, never import its module from
# a client component. Use the new "Secret key" (sb_secret_...) from the
# "Publishable and secret API keys" tab, not the old service_role JWT under
# the separate Legacy tab.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stage 6 inquiry form ---
# The IP is never stored raw; this dedicated salt is used for its SHA-256 hash.
# Keep it stable so the one-hour rate limit remains effective across deploys.
IP_HASH_SALT=

# Notification delivery is best-effort after the inquiry transaction commits.
RESEND_API_KEY=
NOTIFY_TO=hello@creativejourneysph.com
RESEND_FROM="Creative Journeys <hello@creativejourneysph.com>"

# Authenticates Vercel Cron's requests to the Supabase keep-alive endpoint; not user-facing.
CRON_SECRET=
